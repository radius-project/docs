{
	"name": "Radius Docs",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	"features": {
		"ghcr.io/devcontainers/features/git:1.3.8": {},
		"ghcr.io/devcontainers/features/go:1.4.1": {},
		"ghcr.io/devcontainers/features/node:2.1.2": {
			"version": "24"
		}
	},
	"remoteUser": "vscode",
	"postCreateCommand": "npm ci",
	"customizations": {
		"codespaces": {
			"repositories": {
				"radius-project/radius": {
					"permissions": {
						"contents": "read"
					}
				}
			}
		},
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			},
			"extensions": [
				"GitHub.copilot",
				"ms-azuretools.rad-vscode-bicep"
			]
		}
	},
	"portsAttributes": {
		"1313": {
			"label": "hugo server",
			"onAutoForward": "openBrowser"
		}
	}
}
